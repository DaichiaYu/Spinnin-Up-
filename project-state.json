{
  "schema_version": 1,
  "project": {
    "name": "Spinnin-Up",
    "repository": "DaichiaYu/Spinnin-Up-",
    "default_branch": "main",
    "delivery": "GitHub Pages"
  },
  "source_of_truth": {
    "product_spec": {
      "repository": "DaichiaYu/Spin-Up",
      "path": "plan.md",
      "visibility": "private",
      "precedence": "highest"
    },
    "implementation_decisions": "docs/decisions.md",
    "implementation_progress": "docs/roadmap.md"
  },
  "architecture": {
    "frontend": "static-html-css-javascript",
    "backend": false,
    "account_system": false,
    "automatic_user_data_storage": false,
    "exercise_data": "data/exercises.json",
    "generated_assets": [
      "assets/exercises/*.svg",
      "catalog.html"
    ],
    "entry": "index.html -> src/main.js (ES modules, no build step)",
    "modules": {
      "src/workout-engine.js": "training logic, no DOM",
      "src/routine-code.js": "routine link code v1, no DOM",
      "src/calendar.js": "ICS + input validation, no DOM",
      "src/player.js": "player timing state machine, no DOM/audio",
      "src/sound.js": "sound settings, beeps, speech",
      "src/ui.js": "rendering and user input only",
      "src/main.js": "bootstrap + window.__spin test hook",
      "src/profile.js": "body data fields, CSV, analysis, tendency, no DOM",
      "src/generator.js": "workout generation rules + reasons, no DOM",
      "src/feedback.js": "feedback → adjustment rules, no DOM",
      "src/store.js": "in-memory session state",
      "src/dom.js": "DOM helpers",
      "src/screens.js": "home, profile, today, feedback screens"
    },
    "device_preferences_storage": "localStorage spinnin-up.sound (sound mode and volume only, no body data)",
    "body_data_persistence": "in memory only; user downloads/uploads a CSV file",
    "exercise_candidate_data": "data/exercise-candidates.json",
    "exercise_facets": "data/exercise-facets.json"
  },
  "phase": {
    "current": 3,
    "status": "body_profile_spec_v1_pending_user_review",
    "next": 4
  },
  "features": {
    "exercise_data_model": "done",
    "exercise_figures": "done",
    "exercise_catalog": "done",
    "manual_workout_editor": "done",
    "workout_preview_editing": "done",
    "workout_player": "done",
    "routine_link": "done",
    "calendar_export": "done",
    "mobile_background_validation": "pending",
    "onboarding_questionnaire": "done",
    "workout_generation_rules": "done",
    "post_workout_feedback": "done",
    "adaptive_adjustment": "done",
    "sound_modes_and_volume": "done",
    "narration_text_highlight": "done",
    "share_sheet_on_mobile": "done",
    "body_data_csv_download_upload": "done",
    "body_ratio_analysis": "done",
    "trial_exercises": "done",
    "left_right_separate_dose": "done",
    "body_map_for_feedback": "planned",
    "exercise_library_taxonomy": "done",
    "exercise_candidate_pool": "done",
    "exercise_coverage_report": "done",
    "exercise_library_second_source_import": "planned",
    "face_neck_special_library": "planned",
    "body_map_region_panels": "done",
    "self_observations": "done",
    "structure_relative_left_right": "done",
    "capability_by_movement_pattern": "done",
    "today_state": "done",
    "goal_effect_where_intensity": "done",
    "custom_minutes": "done",
    "bed_context": "done",
    "equipment_weight_recorded": "done",
    "frame_size_estimate": "done",
    "observation_free_text_affects_plan": "planned",
    "mobility_stretch_exercises": "planned",
    "equipment_weight_affects_difficulty": "planned"
  },
  "product_constraints": {
    "human_keeps_final_control": true,
    "workout_must_be_editable_before_start": true,
    "body_data_in_share_link": false,
    "external_exercise_images": false,
    "pain_feedback_action": "stop",
    "medical_treatment_claims": false,
    "body_data_in_browser_storage": false
  },
  "agent_contract": {
    "read_order": [
      "project-state.json",
      "AGENTS.md",
      "docs/decisions.md",
      "docs/roadmap.md",
      "private:DaichiaYu/Spin-Up/plan.md when product intent is needed"
    ],
    "required_checks": [
      "python3 -m unittest discover -s tests -v",
      "node --test tests/js/*.test.mjs",
      "python3 tools/validate.py",
      "python3 tools/validate_exercise_library.py",
      "python3 tools/build_figures.py",
      "python3 tools/build_catalog.py",
      "python3 tools/build_exercise_coverage.py",
      "git diff --exit-code -- assets/exercises catalog.html docs/exercise-coverage.md"
    ],
    "update_project_state_when": [
      "phase changes",
      "feature status changes",
      "architecture changes",
      "source-of-truth location changes"
    ]
  },
  "sources_of_truth": {}
}
